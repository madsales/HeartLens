# Copy to .env and fill in, or export these in your shell before `npm start`.

# Required for real analysis. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional. Defaults shown.
# PORT=3000
# HEARTLENS_MODEL=claude-opus-5
# HEARTLENS_EFFORT=medium        # low | medium | high | xhigh | max

# Set to 1 to return canned sample output without calling the API (for UI work).
# HEARTLENS_MOCK=1
