# ============================================================================
#  HeartLens Auto-Poster
#  Copy to .env   ->   heartlens-autopost setup
#  Leave any platform blank to skip it. Nothing here is required to start:
#  with zero credentials the outbox target still writes posts to a file.
# ============================================================================

# ---------------------------------------------------------------- behaviour --
# TRUE = preview only, nothing is ever sent. Flip to false when ready.
DRY_RUN=true

SITE_URL=https://heartlens.app

# IANA timezone; SCHEDULE below is read in this zone.
TIMEZONE=UTC

# 5-field cron: minute hour day-of-month month day-of-week.
# Default = 09:00 and 17:00 daily. "@daily" and friends also work.
SCHEDULE=0 9,17 * * *
SCHEDULE_ENABLED=true

# How many queued posts one scheduled run may publish.
MAX_PER_RUN=1
# Refuse to post to a platform again until this many minutes have passed.
MIN_GAP_MINUTES=30
# When the queue runs dry, rotate through the built-in content pack.
RECYCLE_CONTENT=true
# Refuse identical content published within this many hours.
DUPLICATE_WINDOW_HOURS=72
# One platform failing does not stop the others.
FAIL_OPEN=true
MAX_ATTEMPTS=3
REQUEST_TIMEOUT_MS=30000

# Blank = every platform that has credentials. Or restrict, e.g.:
# ENABLED_PLATFORMS=x,bluesky,telegram,mastodon
ENABLED_PLATFORMS=

LOG_LEVEL=info

# --------------------------------------------------------------- dashboard --
PORT=4310
# Keep this on localhost unless you also set DASHBOARD_TOKEN.
HOST=127.0.0.1
# Required if you expose the dashboard beyond localhost. Any long random string.
DASHBOARD_TOKEN=

# ============================================================================
#  PLATFORMS
# ============================================================================

# -- X / Twitter -------------------------------------------------------------
# developer.x.com -> your project -> Keys and tokens.
# The app must have Read AND Write permission; if you change it, regenerate
# the access token afterwards or posting returns 403.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# -- Bluesky -----------------------------------------------------------------
# Settings -> Privacy and security -> App passwords. Never the real password.
BLUESKY_SERVICE=https://bsky.social
BLUESKY_IDENTIFIER=yourhandle.bsky.social
BLUESKY_APP_PASSWORD=

# -- Mastodon ----------------------------------------------------------------
# Your instance -> Preferences -> Development -> New application.
# Scopes: write:statuses write:media
MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# -- Telegram ----------------------------------------------------------------
# Talk to @BotFather -> /newbot. Then add the bot to your channel as an admin.
# CHAT_ID is like @yourchannel, or a numeric id for a group.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -- Discord -----------------------------------------------------------------
# Channel -> Edit Channel -> Integrations -> Webhooks -> New Webhook -> Copy URL.
DISCORD_WEBHOOK_URL=

# -- Slack (handy as an internal preview channel) ----------------------------
SLACK_WEBHOOK_URL=

# -- Facebook Page -----------------------------------------------------------
# A PAGE access token (not a user token) with pages_manage_posts.
# Personal profiles cannot be posted to through the API at all.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_API_VERSION=v21.0

# -- Instagram (Business or Creator account only) ----------------------------
# Needs the account linked to a Facebook Page, and media must already be
# hosted at a public https URL -- the API will not accept uploaded bytes.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_API_VERSION=v21.0

# -- Threads -----------------------------------------------------------------
# Scopes: threads_basic, threads_content_publish
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# -- LinkedIn ----------------------------------------------------------------
# Scope w_member_social (personal) or w_organization_social (company page).
# URN looks like urn:li:person:AbC123 or urn:li:organization:12345678
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
# Bump this if LinkedIn starts returning 426 Upgrade Required.
LINKEDIN_VERSION=202411

# -- Reddit ------------------------------------------------------------------
# reddit.com/prefs/apps -> create a "script" app.
# IMPORTANT: read the target subreddit's self-promotion rules first. Posting
# your own product repeatedly is the fastest way to get an account banned.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_SUBREDDIT=
REDDIT_USER_AGENT=heartlens-autopost/1.0 by yourusername

# -- Pinterest ---------------------------------------------------------------
# Every pin needs an image. New apps are trial-access until reviewed.
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# -- Tumblr ------------------------------------------------------------------
TUMBLR_ACCESS_TOKEN=
TUMBLR_BLOG_IDENTIFIER=yourblog.tumblr.com

# -- YouTube (video only) ----------------------------------------------------
# Google Cloud console -> YouTube Data API v3 -> OAuth client -> refresh token.
# Unverified apps can only upload as private.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY=public

# -- TikTok (video only) -----------------------------------------------------
# Until your app passes TikTok's audit, uploads land in drafts for you to
# confirm in the app, and only on the developer's own account.
TIKTOK_ACCESS_TOKEN=
TIKTOK_PRIVACY=SELF_ONLY

# -- Webhook relay: everything else ------------------------------------------
# Point this at Zapier / Make / n8n / Buffer / your own endpoint to reach the
# platforms this package cannot post to directly. The call is signed with
# HMAC-SHA256 in X-HeartLens-Signature; verify it before publishing.
WEBHOOK_URL=
WEBHOOK_SECRET=

# -- Outbox: always available, needs nothing ---------------------------------
# Writes each post to data/outbox/*.md for platforms you post to by hand.
OUTBOX_ENABLED=true
OUTBOX_DIR=
